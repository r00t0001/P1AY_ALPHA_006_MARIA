{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p1ay:health:1",
  "type": "object",
  "required": [
    "schema_version",
    "owner_id",
    "content_version",
    "events",
    "staged",
    "rejected",
    "open_conflicts",
    "pending_outbox",
    "peer_applied",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "P1AY_SYNC_HEALTH_01"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "content_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "type": "integer",
      "minimum": 0
    },
    "staged": {
      "type": "integer",
      "minimum": 0
    },
    "rejected": {
      "type": "integer",
      "minimum": 0
    },
    "open_conflicts": {
      "type": "integer",
      "minimum": 0
    },
    "pending_outbox": {
      "type": "integer",
      "minimum": 0
    },
    "peer_applied": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PEER_CONFIRMED",
        "LOCAL_ONLY_OR_PEER_PENDING"
      ]
    }
  },
  "additionalProperties": false
}
