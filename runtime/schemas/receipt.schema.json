{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p1ay:receipt:1",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "owner_id",
    "device",
    "event_id",
    "version",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "P1AY_SYNC_RECEIPT_01"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "APPLIED"
    }
  },
  "additionalProperties": false
}
